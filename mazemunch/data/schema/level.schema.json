{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mazemunch level settings",
  "type": "object",
  "required": ["baseSpeed", "speeds", "frightenedSeconds", "flashSeconds", "startingLives", "extraLifeAt", "points", "pauseFrames", "bonus", "releaseIntervalSeconds", "timings", "chasers"],
  "properties": {
    "baseSpeed": { "type": "number", "minimum": 1 },
    "speeds": {
      "type": "object",
      "required": ["munch", "chaser", "tunnel", "frightened", "eaten"],
      "properties": {
        "munch": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "chaser": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "tunnel": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "frightened": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "eaten": { "type": "number", "minimum": 0.1, "maximum": 3 }
      }
    },
    "frightenedSeconds": { "type": "number", "minimum": 0 },
    "flashSeconds": { "type": "number", "minimum": 0 },
    "startingLives": { "type": "integer", "minimum": 1, "maximum": 9 },
    "extraLifeAt": { "type": "integer", "minimum": 0 },
    "points": {
      "type": "object",
      "required": ["pellet", "power", "firstChaser"],
      "properties": {
        "pellet": { "type": "integer", "minimum": 0 },
        "power": { "type": "integer", "minimum": 0 },
        "firstChaser": { "type": "integer", "minimum": 0 }
      }
    },
    "pauseFrames": {
      "type": "object",
      "required": ["pellet", "power"],
      "properties": {
        "pellet": { "type": "integer", "minimum": 0 },
        "power": { "type": "integer", "minimum": 0 }
      }
    },
    "bonus": {
      "type": "object",
      "required": ["name", "points", "appearAfterPellets", "seconds"],
      "properties": {
        "name": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "appearAfterPellets": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "seconds": { "type": "number", "minimum": 0 }
      }
    },
    "releaseIntervalSeconds": { "type": "number", "minimum": 0 },
    "timings": {
      "type": "object",
      "required": ["readySeconds", "deathSeconds", "clearFlashSeconds"],
      "properties": {
        "readySeconds": { "type": "number", "minimum": 0 },
        "deathSeconds": { "type": "number", "minimum": 0 },
        "clearFlashSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "chasers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "color", "aggression", "startsOutside"],
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "aggression": { "type": "number", "minimum": 0, "maximum": 1 },
          "startsOutside": { "type": "boolean" }
        }
      }
    }
  }
}
