{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mazemunch maze",
  "type": "object",
  "required": ["id", "width", "height", "rows", "legend", "spawns"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "width": { "type": "integer", "minimum": 8, "maximum": 64 },
    "height": { "type": "integer", "minimum": 8, "maximum": 64 },
    "rows": { "type": "array", "items": { "type": "string", "pattern": "^[#.o \\-T]+$" } },
    "legend": { "type": "object" },
    "spawns": {
      "type": "object",
      "required": ["player", "chaserOutside", "houseSlots", "doorEntry", "houseCenter", "bonus"],
      "properties": {
        "player": { "$ref": "#/$defs/tile" },
        "chaserOutside": { "$ref": "#/$defs/tile" },
        "houseSlots": { "type": "array", "items": { "$ref": "#/$defs/tile" } },
        "doorEntry": { "$ref": "#/$defs/tile" },
        "houseCenter": { "$ref": "#/$defs/tile" },
        "bonus": { "$ref": "#/$defs/tile" }
      }
    }
  },
  "$defs": {
    "tile": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
  }
}
